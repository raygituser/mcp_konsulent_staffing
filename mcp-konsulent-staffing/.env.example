# -----------------------------
# Core toggles
# -----------------------------
OPENROUTER_ENABLED=true
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_STRUCTURED_OUTPUTS=true
OPENROUTER_RESPONSE_HEALING=true

# Safety / cost controls
MAX_MATCHING_KONSULENTER=12
OPENROUTER_MAX_TOKENS=220
OPENROUTER_TEMPERATURE=0.4
MAX_COST_CREDITS_PER_REQUEST=0.02
COST_BUDGET_CREDITS_DAILY=2.00

# Local GGUF via llama.cpp server (optional)
LOCAL_GGUF_ENABLED=false
LOCAL_MODEL_PATH=/models/model.gguf
LLAMA_CPP_BASE_URL=http://llama_cpp:8080/v1
LLAMA_CPP_IMAGE=ghcr.io/ggml-org/llama.cpp:server

# Redis (optional)
REDIS_ENABLED=false
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=30

# Rate limiting (SlowAPI)
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_ENABLED=true

# Services
KONSULENT_API_URL=http://konsulent_api:8000

# Observability
METRICS_ENABLED=true

# App
LOG_LEVEL=INFO
# OpenRouter attribution headers (recommended)
OPENROUTER_APP_NAME=mcp-konsulent-staffing
OPENROUTER_APP_REFERER=http://localhost

# Optional per-request cost estimation (pre-check)
OPENROUTER_PRICING_AUTO=true
# Set these if you want strict pre-check (credits per 1k tokens). -1 means auto/unknown.
OPENROUTER_COST_CREDITS_PER_1K_PROMPT=-1
OPENROUTER_COST_CREDITS_PER_1K_COMPLETION=-1
OPENROUTER_CHARS_PER_TOKEN=4

# llama.cpp fast-fail
LLAMA_CPP_TIMEOUT_SECONDS=120

# Optional: distributed rate limiting storage (set to redis://... when using profile redis)
RATE_LIMIT_STORAGE_URI=memory://

# Optional: cache successful OpenRouter results (exact-match) in Redis
LLM_CACHE_ENABLED=false
LLM_CACHE_TTL_SECONDS=300

# OpenRouter key monitor
OPENROUTER_KEY_MONITOR_ENABLED=true
OPENROUTER_KEY_POLL_SECONDS=60
