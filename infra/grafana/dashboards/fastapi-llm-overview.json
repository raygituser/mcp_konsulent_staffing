        },
        {
          "expr": "(sum(rate(semantic_context_requests_total[$__rate_interval])) ) or vector(0)",
          "refId": "B",
          "legendFormat": "context_used"
        },
        {
          "expr": "((sum(rate(semantic_cache_hit_total[$__rate_interval])) + sum(rate(semantic_context_requests_total[$__rate_interval]))) ) or vector(0)",
