# -----------------------------
# Core toggles
# -----------------------------
OPENROUTER_ENABLED=true
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_STRUCTURED_OUTPUTS=true
OPENROUTER_RESPONSE_HEALING=true

# Safety / cost controls
MAX_MATCHING_KONSULENTER=5
OPENROUTER_MAX_TOKENS=200
OPENROUTER_TEMPERATURE=0.1
MAX_COST_CREDITS_PER_REQUEST=0.02
COST_BUDGET_CREDITS_DAILY=0.09

# Local GGUF via llama.cpp server (optional)
LOCAL_GGUF_ENABLED=false
LOCAL_MODEL_PATH=/models/model.gguf
LLAMA_CPP_BASE_URL=http://llama_cpp:8080/v1
LLAMA_CPP_IMAGE=ghcr.io/ggml-org/llama.cpp:server

# Redis (optional)
REDIS_ENABLED=true
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=30

# Semantic similarity / semantic caching (optional; requires REDIS_ENABLED=true)
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.88
SEMANTIC_CACHE_TOP_K=3
SEMANTIC_CACHE_LIMIT_SCAN=200
SEMANTIC_CACHE_RETURN_CACHED=true
SEMANTIC_CACHE_USE_AS_CONTEXT=true

# Rate limiting (SlowAPI)
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_ENABLED=true

# Services
KONSULENT_API_URL=http://konsulent_api:8000

# Observability
METRICS_ENABLED=true

# App
LOG_LEVEL=INFO
# OpenRouter attribution headers (recommended)
OPENROUTER_APP_NAME=mcp-konsulent-staffing
OPENROUTER_APP_REFERER=http://localhost

# Optional per-request cost estimation (pre-check)
OPENROUTER_PRICING_AUTO=true
# Set these if you want strict pre-check (credits per 1k tokens). -1 means auto/unknown.
OPENROUTER_COST_CREDITS_PER_1K_PROMPT=-1
OPENROUTER_COST_CREDITS_PER_1K_COMPLETION=-1
OPENROUTER_CHARS_PER_TOKEN=4

# llama.cpp fast-fail
LLAMA_CPP_TIMEOUT_SECONDS=5

# Circuit breaker (optional)
LLM_CIRCUIT_BREAKER_ENABLED=true
OPENROUTER_CB_FAILURE_THRESHOLD=5
OPENROUTER_CB_RECOVERY_TIMEOUT_SECONDS=60
LLAMA_CB_FAILURE_THRESHOLD=5
LLAMA_CB_RECOVERY_TIMEOUT_SECONDS=30

# Optional: distributed rate limiting storage (set to redis://... when using profile redis)
RATE_LIMIT_STORAGE_URI=memory://

# Optional: cache successful OpenRouter results (exact-match) in Redis
LLM_CACHE_ENABLED=true
LLM_CACHE_TTL_SECONDS=300

# Circuit breaker (recommended)
LLM_CIRCUIT_BREAKER_ENABLED=true
OPENROUTER_CB_FAILURE_THRESHOLD=3
OPENROUTER_CB_RECOVERY_TIMEOUT_SECONDS=20
LLAMA_CB_FAILURE_THRESHOLD=3
LLAMA_CB_RECOVERY_TIMEOUT_SECONDS=10
